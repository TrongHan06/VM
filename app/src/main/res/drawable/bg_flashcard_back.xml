<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient chuyển màu từ trắng tinh khôi sang xanh da trời nhạt -->
    <gradient
        android:angle="315"
        android:endColor="#F0F9FF"
        android:startColor="#FFFFFF"
        android:type="linear" />

    <!-- Đường viền bo xanh da trời tươi sáng giúp thẻ nổi bật -->
    <stroke
        android:width="1.5dp"
        android:color="#60A5FA" />

    <corners android:radius="20dp" />

</shape>
