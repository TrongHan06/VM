<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollViewWordList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="96dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Danh sách từ vựng"
            android:textColor="#1E3A5F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Thanh trượt ngang các lựa chọn bộ lọc kèm hiệu ứng chỉ báo trượt -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <HorizontalScrollView
                android:id="@+id/scrollMainFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupWordList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTopic"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Chủ đề"
                        android:textColor="#1E3A5F"
                        app:chipBackgroundColor="@android:color/white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLearned"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã học"
                        android:textColor="#1E3A5F"
                        app:chipBackgroundColor="@android:color/white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFavorite"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ưa thích"
                        android:textColor="#1E3A5F"
                        app:chipBackgroundColor="@android:color/white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWrong"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hay sai"
                        android:textColor="#1E3A5F"
                        app:chipBackgroundColor="@android:color/white" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAdded"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Được thêm vào"
                        android:textColor="#1E3A5F"
                        app:chipBackgroundColor="@android:color/white" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvScrollHintMain"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_scroll_gradient_right"
                android:gravity="center"
                android:text="›"
                android:textColor="#0D9488"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Thanh trượt ngang phụ cho các chủ đề cụ thể kèm chỉ báo trượt -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <HorizontalScrollView
                android:id="@+id/scrollSubTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSubTopics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvScrollHintSub"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_scroll_gradient_right"
                android:gravity="center"
                android:text="›"
                android:textColor="#0D9488"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyWordList"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="center"
            android:text="Chưa có từ vựng nào trong danh sách này."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- RecyclerView hiển thị danh sách từ vựng theo bộ lọc -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWordList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
