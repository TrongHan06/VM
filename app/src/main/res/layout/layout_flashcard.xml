<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Thanh vạch kéo nhỏ phía trên BottomSheet -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#CBD5E1"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- 2 Dòng thông tin tiêu đề phía trên Flashcard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Dòng 1: FLASHCARD -->
            <TextView
                android:id="@+id/tvFlashcardHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="FLASHCARD"
                android:textColor="#1E3A5F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Counter (e.g. Thẻ 1/10) -->
            <TextView
                android:id="@+id/tvFlashcardCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thẻ 1 / 10"
                android:textColor="#0D9488"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng 2: Chủ đề: <Tên chủ đề> -->
        <TextView
            android:id="@+id/tvFlashcardTopicName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chủ đề: Gia đình"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Progress bar cho phiên Flashcard -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressFlashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="10"
            app:indicatorColor="#0D9488"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

    </LinearLayout>

    <!-- Khung chứa Flashcard (Mặt trước & Mặt sau) -->
    <FrameLayout
        android:id="@+id/flashcard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Mặt sau: mặc định ẩn -->
        <FrameLayout
            android:id="@+id/cardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flashcard_back"
            android:clipToOutline="true"
            android:elevation="6dp"
            android:rotationY="180"
            android:visibility="gone">

            <!-- Nghĩa tiếng Việt & Câu ví dụ ở chính giữa mặt sau -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvMeaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gia đình"
                    android:textColor="#1E3A5F"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExample"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="I love my family."
                        android:textColor="#334155"
                        android:textSize="15sp"
                        android:textStyle="italic" />

                    <ImageButton
                        android:id="@+id/btnSpeakExample"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Nghe câu ví dụ"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_speaker"
                        app:tint="#2563EB" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExampleMeaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="(Tôi yêu gia đình tôi.)"
                    android:textColor="#64748B"
                    android:textSize="13.5sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Mặt trước -->
        <FrameLayout
            android:id="@+id/cardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flashcard_front"
            android:clipToOutline="true"
            android:elevation="6dp">

            <!-- Level & WordType Badge at top right -->
            <TextView
                android:id="@+id/tvFlashcardMetaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_option_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="noun • A1"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Từ tiếng Anh & Phiên âm IPA ở chính giữa mặt trước -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="/ˈfæməli/"
                    android:textColor="#93C5FD"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Gợi ý lật thẻ ở góc dưới bên phải -->

            <!-- Nút loa nghe phát âm -->
            <TextView
                android:id="@+id/btnPronunciation"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pronunciation"
                android:clickable="true"
                android:drawableStart="@drawable/ic_speaker"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/listen_pronunciation"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp" />

        </FrameLayout>

    </FrameLayout>

    <!-- 2 Nút điều hướng Flashcard (Từ trước & Từ tiếp theo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Nút: ← Từ trước -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviousWord"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="← Từ trước"
            android:textColor="#334155"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="50dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1.2dp" />

        <!-- Nút: Từ tiếp theo → -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextWord"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Từ tiếp theo →"
            android:textColor="@android:color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:backgroundTint="#1E3A5F"
            app:cornerRadius="50dp" />

    </LinearLayout>

</LinearLayout>
