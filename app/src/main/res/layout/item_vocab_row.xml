<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVocabRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Indicator bar left for learned status -->
        <View
            android:id="@+id/vLearnedIndicator"
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="#16A34A"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRowWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- CEFR Level Badge (e.g. A1, B2) -->
                <TextView
                    android:id="@+id/tvRowLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_option_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="A1"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tag từ loại (noun, verb, adj...) -->
                <TextView
                    android:id="@+id/tvRowWordType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="n"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tvRowPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/phonetic/"
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRowMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nghĩa tiếng Việt"
                android:textColor="#0D9488"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Nút Loa phát âm chuẩn (nền tròn xanh nhạt #EFF6FF) -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_option_badge">

            <ImageButton
                android:id="@+id/btnRowSpeaker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Nghe phát âm"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speaker"
                app:tint="#2563EB" />
        </FrameLayout>

        <!-- Nút Yêu thích (Ngôi sao) -->
        <ImageButton
            android:id="@+id/btnRowFavorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lưu yêu thích"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
