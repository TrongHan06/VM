<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Container giới hạn độ rộng tối đa 720dp để hiển thị đẹp trên Tablet/Foldable/Landscape -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="720dp"
        android:orientation="vertical">

        <!-- Thanh vạch kéo nhỏ phía trên BottomSheet -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#CBD5E1"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <!-- 2 Dòng thông tin tiêu đề phía trên Ôn tập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Dòng 1: ÔN TẬP -->
            <TextView
                android:id="@+id/tvPracticeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="ÔN TẬP"
                android:textColor="#1E3A5F"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- Dòng 2: Chủ đề: <Tên chủ đề> -->
            <TextView
                android:id="@+id/tvPracticeTopicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Chủ đề: Gia đình"
                android:textColor="#64748B"
                android:textSize="12.5sp" />

            <!-- Session Progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressQuizSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="10"
                app:indicatorColor="#1E3A5F"
                app:trackColor="#E2E8F0"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

        </LinearLayout>

        <!-- Khu vực cuộn cuộn thích ứng cho màn hình thấp / xoay ngang -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Hộp chứa Câu hỏi bài tập -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPracticeQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPracticeWord"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text=""
                            android:textColor="#1E3A5F"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="28sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPracticePhonetic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#64748B"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/btnPracticePronunciation"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pronunciation"
                                android:clickable="true"
                                android:drawableStart="@drawable/ic_speaker"
                                android:drawablePadding="4dp"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/listen_pronunciation"
                                android:textColor="#FFFFFF"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Danh sách 4 Hộp Đáp án trắc nghiệm -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Đáp án A -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOptionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBadgeOptionA"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_option_badge"
                                android:gravity="center"
                                android:text="A"
                                android:textColor="#1E3A5F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOptionA"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text=""
                                android:textColor="#1E293B"
                                android:textSize="15sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Đáp án B -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOptionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBadgeOptionB"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_option_badge"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#1E3A5F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOptionB"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text=""
                                android:textColor="#1E293B"
                                android:textSize="15sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Đáp án C -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOptionC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBadgeOptionC"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_option_badge"
                                android:gravity="center"
                                android:text="C"
                                android:textColor="#1E3A5F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOptionC"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text=""
                                android:textColor="#1E293B"
                                android:textSize="15sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Đáp án D -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOptionD"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBadgeOptionD"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_option_badge"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#1E3A5F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOptionD"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text=""
                                android:textColor="#1E293B"
                                android:textSize="15sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- 3. Hộp giải thích chi tiết -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#F8FAFC"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvExplanationResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExplanationExample"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text=""
                            android:textColor="#334155"
                            android:textSize="13.5sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/tvExplanationMeaning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Nút "Câu tiếp theo →" / "Hoàn thành" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPractice"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Câu tiếp theo →"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#1E3A5F"
            app:cornerRadius="50dp" />

    </LinearLayout>

</LinearLayout>
